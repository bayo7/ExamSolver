# ══════════════════════════════════════════════════════════════
#  VisionSolve MCQ — Ortam Değişkenleri
#  Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi girin.
#  .env asla git'e eklenmemeli!
# ══════════════════════════════════════════════════════════════

# ── LLM Provider ───────────────────────────────────────────────
LLM_PROVIDER=google
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GOOGLE_API_KEY=AIzaSy...
API_DELAY=1.5
MAX_RETRIES=3

# ── Google Cloud Function (AI Solver) ─────────────────────────
# Boş bırakılırsa solver yerel olarak çalışır.
CLOUD_FUNCTION_URL=
# Örnek: https://us-central1-PROJE_ID.cloudfunctions.net/solve_question

# ── Firebase Admin SDK (Backend — GİZLİ, paylaşmayın) ─────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=abc123
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ── Firebase Web Config (Frontend — paylaşılabilir) ────────────
FIREBASE_WEB_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abc123

